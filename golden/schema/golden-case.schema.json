{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/feamar/mtg-judge/golden/schema/golden-case.schema.json",
  "title": "GoldenCase",
  "description": "One golden test case (PRD §8, ADR-0013). Written as YAML in golden/cases/. The narrative Markdown in golden/scenarios/ stays the human-readable view.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "family",
    "validation",
    "set",
    "origin",
    "sources",
    "context",
    "input",
    "expect"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "narrative": {
      "type": "string",
      "description": "Path to the Markdown scenario, if any."
    },
    "family": {
      "type": "string",
      "description": "Answering family (docs/research legend): targeting, triggers, layers, copy, replacement, timing, costs, mana, zones, commander, lki, investigation."
    },
    "variantOf": {
      "type": "string"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "VALIDATED",
            "SOURCE_CHECK_REQUIRED"
          ]
        },
        "by": {
          "type": "string"
        },
        "on": {
          "type": "string",
          "format": "date"
        },
        "openPoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What the owner still has to confirm."
        },
        "note": {
          "type": "string",
          "description": "Free-text validation history, e.g. from an imported record."
        }
      }
    },
    "tag": {
      "enum": [
        "easy",
        "hard"
      ],
      "description": "Set by the owner only."
    },
    "tagProposed": {
      "enum": [
        "easy",
        "hard"
      ],
      "description": "Architect's proposal; the owner confirms by setting 'tag'."
    },
    "set": {
      "enum": [
        "dev",
        "regression",
        "heldout"
      ]
    },
    "origin": {
      "enum": [
        "owner-real-case",
        "owner-question",
        "chatgpt-package",
        "league-export",
        "ai-generated",
        "public-qa",
        "judge-lab",
        "owner-scenario"
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cr"
      ],
      "properties": {
        "cr": {
          "type": "string",
          "description": "CR effective date the expected answer was checked against, e.g. 2026-09-25."
        },
        "ipg": {
          "type": "string"
        },
        "mtr": {
          "type": "string"
        },
        "addendum": {
          "type": "string"
        },
        "oracle": {
          "type": "string",
          "description": "Card-data date, or 'scryfall@YYYY-MM-DD'."
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "rel"
      ],
      "properties": {
        "format": {
          "enum": [
            "cEDH",
            "Legacy",
            "multiplayer",
            "any"
          ],
          "description": "'any' = a general rules question not tied to a format. Legacy (1v1) is post-MVP; the MVP release gate uses cEDH, multiplayer and any."
        },
        "rel": {
          "enum": [
            "Competitive",
            "Regular",
            "not-material"
          ],
          "description": "'not-material' = pure gameplay ruling; REL doesn't change the answer."
        },
        "framework": {
          "type": [
            "string",
            "null"
          ],
          "description": "null = plain MTR+IPG; else an addendum id such as MTRA@2025-06-24 (OQ-20)."
        },
        "seats": {
          "type": "integer",
          "minimum": 2
        },
        "inGame": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "true = minimum in-game explanation depth applies (FR-Q-5); null = not stated."
        },
        "eventPolicies": {
          "type": "array",
          "description": "TO-configured event policies (ADR-0020). They amend tournament policy only, never game rules.",
          "items": {
            "type": "object",
            "required": [
              "policyId",
              "amends",
              "when",
              "effect",
              "text"
            ],
            "properties": {
              "policyId": {
                "type": "string"
              },
              "amends": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "effect": {
                "enum": [
                  "replace-consequence",
                  "waive-consequence",
                  "add-guidance"
                ]
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw"
      ],
      "properties": {
        "raw": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seat",
              "text"
            ],
            "properties": {
              "seat": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "pauseAfter": {
                "type": "integer",
                "description": "Seconds of pause after this message. A pause alone never ends narration (ADR-0019); used to test the safety net and that the judge does not interrupt mid-story pauses."
              },
              "volunteer": {
                "type": "boolean",
                "description": "This message volunteers to explain (e.g. 'I'll explain')."
              }
            }
          }
        },
        "choices": {
          "type": "object",
          "description": "Scripted answers to the judge's questions, keyed by fact id. Value may be keyed by seat for per-seat knowledge.",
          "additionalProperties": true
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Exact card names the resolver must find."
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Stated assumptions that count as supplied facts."
        },
        "variants": {
          "type": "array",
          "description": "Messy phrasings that must yield the same canonical question and identical answer (ADR-0018). Generated noise is not stored; it's produced by golden/tools/noisify.mjs at test time.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "kind"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "human",
                  "stt"
                ]
              },
              "origin": {
                "type": "string",
                "description": "e.g. league-export (pseudonymised), miss-log, owner, S1 recording id"
              },
              "expectClarification": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Slots the judge should ask about for this variant instead of resolving (e.g. an ambiguous nickname)."
              }
            }
          }
        },
        "entryContext": {
          "description": "How the case reached the judge (Judge Lab bundle)."
        },
        "eventIntegritySetting": {
          "description": "The TO integrity mode for this case (Judge Lab bundle; see golden/import bundle metadata)."
        },
        "availableIntegritySettings": {
          "description": "Integrity modes the case must be run under (Judge Lab bundle)."
        },
        "applicationAuthority": {
          "description": "Remedies the app may perform itself in this case (Judge Lab bundle)."
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "answer",
        "requiredCitations",
        "escalate"
      ],
      "properties": {
        "kind": {
          "enum": [
            "rules-question",
            "dispute",
            "concept"
          ]
        },
        "intent": {
          "type": "string",
          "description": "Proposed intent id, e.g. does-X-trigger-Y. Becomes an entry/strategy id once those exist."
        },
        "answer": {
          "type": "string",
          "description": "The expected conclusion in one or two sentences."
        },
        "deciding": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Facts that select the branch; each variant changes one."
        },
        "infraction": {
          "type": "string"
        },
        "penalty": {
          "type": "string"
        },
        "fix": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deliveryPattern": {
          "enum": [
            "explain-then-penalty",
            "penalty-then-explain",
            "ruling-explain-ruling",
            "summary-explain-exact",
            "penalty-only"
          ]
        },
        "requiredCitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "CR:x, IPG:x, MTR:x, MTRA:x, Oracle:<card>, Ruling:<card>@<date>."
        },
        "requiredQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbiddenQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mustNot": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Behaviours that fail the case, e.g. play-advice, reveal-integrity-suspicion."
        },
        "escalate": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "propositions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Intermediate propositions the answer must support (PRD §8: tests check intermediate steps)."
        },
        "chain": {
          "type": "array",
          "description": "Source -> proposition -> consequence steps.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sources",
              "propositions",
              "consequence"
            ],
            "properties": {
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "propositions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "consequence": {
                "type": "string"
              }
            }
          }
        },
        "canonical": {
          "type": "object",
          "description": "Expected canonical question (ADR-0018): what normalisation must produce from the clean input and every variant.",
          "properties": {
            "cards": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "intent": {
              "type": "string"
            },
            "seats": {
              "type": "object"
            },
            "stated": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "claims": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "intake": {
          "type": "object",
          "description": "Expected narration-intake behaviour (ADR-0019).",
          "additionalProperties": false,
          "properties": {
            "narrator": {
              "type": "string"
            },
            "endedBy": {
              "enum": [
                "question",
                "arises",
                "wrap-up",
                "safety-net",
                "skip"
              ]
            },
            "prompt": {
              "enum": [
                "what-is-your-question",
                "how-can-i-help",
                "none"
              ]
            },
            "noInterruption": {
              "type": "boolean"
            },
            "timeline": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "staffMessage": {
          "type": "string",
          "description": "Expected judge-only-channel message, e.g. an event-management referral to the TO (ADR-0020)."
        },
        "disposition": {
          "enum": [
            "RESOLVED",
            "NEEDS_CLARIFICATION",
            "HANDOFF_TO_HUMAN"
          ],
          "description": "Outcome kind (Judge Lab bundle)."
        },
        "playerFacingMessage": {
          "description": "Exact player-facing message expected, e.g. the neutral handoff message."
        },
        "handoff": {
          "description": "Expected handoff content (Judge Lab bundle; protected, staff-only)."
        },
        "integrityPolicy": {
          "description": "Expected integrity classification (Judge Lab bundle)."
        },
        "stageExpectations": {
          "description": "Expected behaviour per integrity mode and workflow stage (Judge Lab bundle)."
        },
        "remedy": {
          "description": "Expected remedy details (Judge Lab bundle)."
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "description": "Where the case came from: source URL, source ids, source versions, card oracle ids. Free-form; kept verbatim on import."
    }
  }
}